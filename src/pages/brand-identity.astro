---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Logo from '../components/Logo.astro';
import Seal from '../components/Seal.astro';

/* STAND-IN PHOTOS from Unsplash (free under the Unsplash License).
   REPLACE WITH MY OWN: put your photos in public/images/ and change `src`
   to e.g. `${base}/images/bell-tower.jpg`, then update `alt` and the
   credit line in the footer. Unsplash crops them to the frame size here. */
const unsplash = (id: string, w: number, h: number) =>
  `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&h=${h}&q=80`;

const photos = {
  // REPLACE WITH MY OWN: bell tower (stand-in: Bruges, by Loris Boulinguez)
  tower: {
    src: unsplash('photo-1759338045442-017c39e79568', 960, 1200),
    src2x: unsplash('photo-1759338045442-017c39e79568', 1920, 2400),
    width: 960,
    height: 1200,
    alt: 'A tall medieval bell tower against a cloudy sky in Bruges, Belgium.',
  },
  // REPLACE WITH MY OWN: workshop or clock mechanism (stand-in: watch gears, by Laura Ockel)
  workshop: {
    src: unsplash('photo-1593153041370-5ebf6b82886a', 1200, 900),
    src2x: unsplash('photo-1593153041370-5ebf6b82886a', 2400, 1800),
    width: 1200,
    height: 900,
    alt: 'Close-up of metal gears, wheels and springs taken from old watches.',
  },
};

const workshop = [
  {
    title: 'Water mills',
    text: 'Cistercian monks ran streams through the middle of their monasteries and used the water to grind grain, full cloth and saw timber, then shared what worked with houses across Europe.',
  },
  {
    title: 'Preserved books',
    text: 'In their scriptoriums, monks copied books by hand, keeping science, history and literature alive for the people who came after them.',
  },
  {
    title: 'Crop breeding',
    text: 'In his abbey garden in Brno, the friar Gregor Mendel grew about 28,000 pea plants between 1856 and 1863 and worked out the rules of inheritance.',
  },
  {
    title: 'Mechanical clocks',
    text: 'Richard of Wallingford, abbot of St Albans, designed an astronomical clock that showed the sun, moon, stars and tides. He died in 1336; his monks finished it.',
  },
];

const principles = [
  {
    title: 'A community first',
    text: 'Each watch is made for a group of people and the thing they love, and you should see it in the case and the dial.',
  },
  {
    title: 'A category moved forward',
    text: 'We start from a kind of watch people already know and ask what it could become next, instead of restyling one that exists.',
  },
  {
    title: 'The timeless and the futuristic',
    text: 'Some of our designs will look like they have always existed. Others will look ahead. Both start from careful work on the case and the dial.',
  },
];
---

<BaseLayout
  title="Brand identity · Monasterie Watch Company"
  description="Why our logo is a bell tower, what the monks who rang those bells built, what Conversatio Morum means to us, and who started Monasterie."
  ground="parchment"
>
  <TopBar />
  <main id="main">
    <!-- 1. Hero -->
    <section class="bi-hero" aria-labelledby="bi-title">
      <div class="wrap bi-hero-inner">
        <Seal class="bi-hero-seal" />
        <h1 id="bi-title">Monasterie Watch Company</h1>
        <p class="bi-hero-line">
          We don't put our own spin on existing watches. We evolve each category and bring
          new ideas to watchmaking.
        </p>
      </div>
    </section>

    <!-- 2. The bell tower -->
    <section class="bi-screen" aria-labelledby="tower">
      <div class="wrap bi-tower">
        <div class="bi-text">
          <h2 id="tower">The bell tower at the center of town</h2>
          <p>
            For centuries, the bell tower stood at the center of town. It was often the
            tallest building there, and long before there were clocks in homes or watches on
            wrists, people looked up to it to know the hour.
          </p>
          <p>
            Its bells marked the day for everyone, from first light to nightfall. They called
            people together, rang for celebrations and sounded the alarm when something went
            wrong. The tower gave a town a shared sense of time and a place to gather, and the
            building beneath it offered shelter. It was where news arrived and new ideas
            spread.
          </p>
        </div>
        <figure class="bi-photo bi-photo-tall">
          <!-- REPLACE WITH MY OWN: stand-in photo from Unsplash -->
          <img
            src={photos.tower.src}
            srcset={`${photos.tower.src} 1x, ${photos.tower.src2x} 2x`}
            width={photos.tower.width}
            height={photos.tower.height}
            alt={photos.tower.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- 3. The monastery as a workshop -->
    <section class="bi-screen" aria-labelledby="workshop">
      <div class="wrap bi-workshop">
        <figure class="bi-photo bi-photo-wide">
          <!-- REPLACE WITH MY OWN: stand-in photo from Unsplash -->
          <img
            src={photos.workshop.src}
            srcset={`${photos.workshop.src} 1x, ${photos.workshop.src2x} 2x`}
            width={photos.workshop.width}
            height={photos.workshop.height}
            alt={photos.workshop.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="bi-text">
          <h2 id="workshop">The monastery as a workshop</h2>
          <p>
            The people who rang those bells were monks, and the monastery was far more than a
            place of prayer. It was the workshop and research lab of its time. Monks were
            scholars and builders, as skilled with delicate handwork as with hard labor, and
            they served the town around them.
          </p>
        </div>
        <ul class="bi-workshop-list" role="list">
          {workshop.map((w) => (
            <li>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Conversatio Morum -->
    <section class="bi-screen bi-motto" data-ground="plum" aria-labelledby="motto">
      <div class="wrap">
        <p class="label muted">Our motto</p>
        <h2 id="motto" class="bi-motto-title"><span>Conversatio</span> <span>Morum</span></h2>
        <div class="bi-motto-text">
          <p>
            Each monk took a vow called <em>conversatio morum</em>, a promise to keep changing
            for the better every day of his life. It was never a promise to be perfect, only a
            promise to keep working at it.
          </p>
          <p>
            We aren't a religious company. We honor who those monks were as people: inventive,
            disciplined, hardworking, rooted in their community, and always trying to become
            better than they were the day before. Monasterie, the Middle English spelling of
            monastery, is our version of that place: a workshop for designing watches.
          </p>
          <p>
            Every watch we make is built to keep your hours with care, and to remind you that
            each one is another chance to grow.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. The marks -->
    <section class="bi-screen" aria-labelledby="marks">
      <div class="wrap bi-marks">
        <div class="bi-text">
          <h2 id="marks">Our marks</h2>
          <p>
            Our logo is the bell tower because we want to earn the place it once held, a brand
            people can look up to.
          </p>
          <p>
            The icon is the tower's window with its light on, an eight-point star. The
            wordmark is set in Metamorphous, always in capitals. In the second wordmark the A
            becomes the window itself.
          </p>
        </div>
        <div class="bi-marks-board">
          <div class="bi-marks-tile" data-ground="plum">
            <Logo variant="icon" height="62%" />
          </div>
          <div class="bi-marks-words">
            <Logo variant="wordmark" width="100%" />
            <Logo variant="wordmark-star" width="78%" />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. What we design -->
    <section class="bi-screen" aria-labelledby="design">
      <div class="wrap bi-design">
        <div class="bi-text">
          <p class="label muted">What we design</p>
          <h2 id="design">Our design language</h2>
          <p>
            Every Monasterie design starts with two questions: who is it for, and where can this
            kind of watch go next?
          </p>
          <ul class="bi-principles" role="list">
            {principles.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- SLOT: replace this drawing with a render or sketch of a Monasterie design.
             Drop the file in public/images/ and swap the <svg> for an <img>. -->
        <div class="bi-sketch" aria-hidden="true">
          <svg viewBox="0 0 400 440" fill="none" stroke="currentColor">
            <!-- construction lines -->
            <g class="sketch-guides">
              <line x1="200" y1="10" x2="200" y2="430" />
              <line x1="20" y1="245" x2="380" y2="245" />
              <circle cx="200" cy="245" r="150" />
              <circle cx="200" cy="245" r="96" />
              <line x1="94" y1="139" x2="306" y2="351" />
              <line x1="306" y1="139" x2="94" y2="351" />
            </g>
            <!-- the window and star, drawn as an outline -->
            <g class="sketch-mark" transform="translate(200 245) scale(1.12) translate(-128 -157.9)">
              <path d="M70 149L70 103.6C70 70.3 97.4 55.7 116.8 36.1L116.8 61.5C100.7 70.5 84.6 85.1 84.4 105L84.4 109L78.4 115L84.4 123.1L84.4 147.7L70 149ZM171.6 147.7L171.6 123.1L177.6 115L171.6 109L171.6 105C171.4 85.1 155.3 70.5 139.2 61.5L139.2 36.1C158.6 55.7 186 70.3 186 103.6L186 149L171.6 147.7ZM84.4 225.6L119.6 225.6L120.8 240L70 240L70 166.9L84.4 168.1L84.4 192.8L78.4 200.8L84.4 206.9ZM136.4 225.6L171.6 225.6L171.6 206.9L177.6 200.8L171.6 192.8L171.6 168.1L186 166.9L186 240L135.2 240L136.4 225.6Z" />
              <path d="M111 165.6L21.3 157.9L111 150.3L82.2 112.2L120 140.6L128 4L136.1 140.6L173.8 112.2L145 150.3L234.7 157.9L145 165.6L173.8 203.7L135.7 175L128 269.7L120.3 175L82.2 203.7L111 165.6Z" />
            </g>
          </svg>
        </div>
      </div>
    </section>

    <!-- 7. The founder -->
    <section class="bi-screen bi-founder-section" aria-labelledby="founder">
      <div class="wrap bi-founder">
        <div>
          <h2 id="founder">The founder</h2>
          <p class="bi-founder-name">Matthew Sheets</p>
          <p class="label muted">Founder and designer</p>
        </div>
        <div class="bi-founder-text">
          <p>I'm a chemical engineering student at the University of Cincinnati.</p>
          <p>
            When I finished my first year of college, I bought myself a solar quartz dress
            watch. That watch is where this started. I wanted to understand what watches mean to
            the people who wear them, how they work and how they are designed.
          </p>
          <p>
            I'm starting Monasterie now because if I don't start it now, when will I ever?
            Fortune favors the bold.
          </p>
          <p>
            This brand isn't only for me or my love of watches. It's a chance to reach out, meet
            people, and share innovation, passion and humanity with many different people. Most
            of all, I want you to enjoy wearing our watches. If one puts a smile on your face,
            that's what it's for.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bi-footer">
    <div class="wrap bi-footer-inner">
      <p class="small">Monasterie Watch Company · Conversatio Morum</p>
      <p class="small muted">
        Photos from Unsplash: bell tower by{' '}
        <a href="https://unsplash.com/photos/historic-bell-tower-against-a-cloudy-sky-7xWcn4hzR-4">Loris Boulinguez</a>,
        watch gears by{' '}
        <a href="https://unsplash.com/photos/gold-and-silver-studded-accessory-RZSrqJjhkeg">Laura Ockel</a>.
      </p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ---- Screens -------------------------------------------------------------
     Every section is exactly one or two screens tall. A small script below
     measures each one and sets --h to 1, or 2 when its content needs it
     (phones, tablets). Without the script they fall back to at least one
     screen, so nothing is ever cut off.                                     */
  .bi-screen {
    --screen: calc(100svh - var(--bar-h));
    min-height: var(--screen);
    display: flex;
    align-items: center;
    padding-block: var(--space-9);
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-plum) 14%, transparent);
  }
  .bi-screen > .wrap {
    width: 100%;
  }
  :global(.js) .bi-screen[data-h] {
    min-height: 0;
    height: calc(var(--h) * var(--screen));
  }
  .bi-screen[data-ground='plum'] {
    border-top: 0;
  }
  .bi-motto {
    padding-block: var(--space-7);
  }

  .bi-text h2 {
    margin-bottom: var(--space-5);
  }
  .bi-text p {
    max-width: 36rem;
  }
  h3 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-2);
  }

  /* ---- 1. Hero ---------------------------------------------------------------- */
  .bi-hero {
    height: calc(100svh - var(--bar-h));
    min-height: 34rem;
    display: flex;
    align-items: center;
    text-align: center;
  }
  /* very short screens (small phones): let the hero grow instead of clipping */
  @media (max-height: 700px) {
    .bi-hero {
      height: auto;
      min-height: calc(100svh - var(--bar-h));
      padding-block: var(--space-7);
    }
  }
  .bi-hero-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }
  .bi-hero :global(.bi-hero-seal) {
    height: min(52svh, 30rem);
    width: auto;
    margin-bottom: var(--space-3);
    animation: settle 700ms var(--ease-out) both;
  }
  .bi-hero h1 {
    margin: 0;
    animation: fade 500ms ease 250ms both;
  }
  .bi-hero-line {
    max-width: 34rem;
    margin: 0;
    font-size: var(--text-h4);
    line-height: 1.5;
    color: var(--text-muted);
    animation: fade 500ms ease 400ms both;
  }

  /* ---- Photos ------------------------------------------------------------------ */
  .bi-photo {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-plum) 12%, var(--color-parchment));
  }
  .bi-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- 2. Bell tower: text left, tall photo right --------------------------- */
  .bi-tower {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .bi-photo-tall {
    aspect-ratio: 4 / 5;
    max-height: 72svh;
    width: 100%;
  }
  @media (min-width: 900px) {
    .bi-tower {
      grid-template-columns: 6fr 5fr;
    }
  }

  /* ---- 3. Workshop: wide photo with intro, four facts in a row --------------- */
  .bi-workshop {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .bi-photo-wide {
    aspect-ratio: 4 / 3;
  }
  .bi-workshop-list {
    list-style: none;
    padding: var(--space-6) 0 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-plum) 14%, transparent);
  }
  .bi-workshop-list p {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  @media (min-width: 768px) {
    .bi-workshop-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .bi-workshop {
      grid-template-columns: 5fr 6fr;
    }
    .bi-workshop-list {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---- 4. Motto: the moment ----------------------------------------------- */
  /* The big type moment: the motto fills the screen. Sized by width and
     by height so both lines always fit on one screen. */
  .bi-motto-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: min(21vw, 17svh);
    line-height: 0.92;
    letter-spacing: -0.015em;
    color: var(--color-parchment);
    margin: var(--space-3) 0 var(--space-6);
  }
  .bi-motto-title span {
    display: block;
    width: max-content;
  }
  .bi-motto-title span + span {
    margin-left: 0.9em; /* second line steps in, like a carved inscription */
  }
  .bi-motto-text {
    display: grid;
    gap: var(--space-2) var(--space-7);
    border-top: var(--border-width) solid var(--color-cerulean);
    padding-top: var(--space-6);
  }
  .bi-motto-text p {
    margin: 0 0 var(--space-4);
  }
  .bi-motto-text p {
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }
  @media (min-width: 1024px) {
    .bi-motto-text {
      grid-template-columns: repeat(3, 1fr);
    }
    .bi-motto-text p {
      font-size: var(--text-body);
      line-height: var(--leading-body);
    }
  }
  /* The title wipes in once, the first time it scrolls into view.
     Only hidden when JS is running, so it can never get stuck invisible. */
  :global(.js) .bi-motto-title span {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1100ms var(--ease-in-out);
  }
  :global(.js) .bi-motto-title span + span {
    transition-delay: 180ms;
  }
  :global(.js) .bi-motto-title.is-in span {
    clip-path: inset(0 0 0 0);
  }

  /* ---- 5. Marks ------------------------------------------------------------ */
  .bi-marks {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .bi-marks-board {
    display: grid;
    grid-template-columns: minmax(7rem, 2fr) 5fr;
    gap: var(--space-6);
    align-items: center;
  }
  .bi-marks-tile {
    aspect-ratio: 1;
    border-radius: var(--radius);
    display: grid;
    place-items: center;
  }
  .bi-marks-tile :global(.logo) {
    width: auto;
  }
  .bi-marks-words {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 900px) {
    .bi-marks {
      grid-template-columns: 5fr 7fr;
    }
  }

  /* ---- 6. Design language -------------------------------------------------- */
  .bi-design {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .bi-principles {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .bi-principles li {
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-cerulean);
  }
  .bi-principles p {
    margin: 0;
  }
  .bi-sketch {
    color: var(--color-plum);
    border: var(--border-width) solid color-mix(in srgb, var(--color-plum) 18%, transparent);
    border-radius: var(--radius);
    padding: var(--space-6);
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }
  .bi-sketch svg {
    width: 100%;
    height: auto;
  }
  .sketch-guides {
    stroke: var(--color-cerulean);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }
  .sketch-mark path {
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  @media (min-width: 900px) {
    .bi-design {
      grid-template-columns: 7fr 5fr;
    }
  }

  /* ---- 7. Founder ----------------------------------------------------------- */
  .bi-founder {
    display: grid;
    gap: var(--space-6);
  }
  .bi-founder-name {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h3);
    color: var(--heading);
    margin: 0 0 var(--space-1);
  }
  .bi-founder-text {
    max-width: 38rem;
  }
  @media (min-width: 900px) {
    .bi-founder {
      grid-template-columns: 4fr 7fr;
      align-items: start;
    }
  }

  /* ---- Footer -------------------------------------------------------------- */
  .bi-footer {
    padding-block: var(--space-7);
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-plum) 14%, transparent);
  }
  .bi-footer-inner p {
    margin: 0 0 var(--space-2);
    max-width: none;
  }

  /* ---- Motion -------------------------------------------------------------- */
  @keyframes settle {
    from { opacity: 0; scale: 0.97; }
  }
  @keyframes fade {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bi-hero :global(.bi-hero-seal) {
      animation: fade 200ms ease both;
    }
    :global(.js) .bi-motto-title span {
      clip-path: none;
      transition: none;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  // Size each section to exactly one or two screens.
  const sections = document.querySelectorAll<HTMLElement>('.bi-screen');
  const size = () => {
    const bar = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--bar-h')) * 16 || 56;
    const screen = window.innerHeight - bar;
    sections.forEach((s) => {
      s.removeAttribute('data-h');
      const cs = getComputedStyle(s);
      const inner = s.firstElementChild as HTMLElement;
      const needed = inner.offsetHeight + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
      const h = needed <= screen + 1 ? 1 : needed <= 2 * screen ? 2 : 0;
      if (h) {
        s.dataset.h = String(h);
        s.style.setProperty('--h', String(h));
      }
    });
  };
  size();
  document.fonts?.ready.then(size);
  let t: number | undefined;
  addEventListener('resize', () => {
    clearTimeout(t);
    t = window.setTimeout(size, 150);
  });
  const title = document.querySelector('.bi-motto-title');
  if (title) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            title.classList.add('is-in');
            io.disconnect();
          }
        },
        { threshold: 0.4 }
      );
      io.observe(title);
    } else {
      title.classList.add('is-in');
    }
  }
</script>
