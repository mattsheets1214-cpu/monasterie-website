---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout>
  <main id="main" class="hero">
    <div class="wrap">
      <Logo variant="icon" height="clamp(7rem, 14vw, 10rem)" decorative class="hero-icon" />
      <h1 class="hero-name">
        <Logo variant="wordmark" width="min(100%, 40rem)" />
      </h1>
      <p class="motto">Conversatio Morum</p>
      <hr />
      <p class="lede">
        We design watches, from the timeless to the futuristic, in the spirit of
        the monks who improved the human experience.
      </p>
      <p class="label muted soon">Site under construction</p>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    text-align: center;
    padding-block: var(--space-9);
  }
  .hero .wrap > * {
    margin-inline: auto;
  }
  .hero :global(.hero-icon) {
    width: auto;
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }
  .hero-name {
    margin-bottom: 0;
  }
  .hero-name :global(.logo) {
    margin-inline: auto;
  }
  .motto {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-h4);
    margin-top: var(--space-6);
  }
  hr {
    width: var(--space-7);
    margin: var(--space-6) auto;
  }
  .lede {
    max-width: 34rem;
  }
  .soon {
    margin-top: var(--space-7);
  }
</style>
