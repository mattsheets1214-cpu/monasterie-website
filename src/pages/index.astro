---
import BaseLayout from '../layouts/BaseLayout.astro';
import BellTower from '../components/BellTower.astro';
---

<BaseLayout>
  <main id="main" class="hero">
    <div class="wrap">
      <div class="mark"><BellTower size={56} /></div>
      <h1 class="wordmark">Monasterie</h1>
      <p class="label muted sub">Watch Company</p>
      <p class="motto">Conversatio Morum</p>
      <hr />
      <p class="lede">
        We design watches, from the timeless to the futuristic, in the spirit of
        the monks who improved the human experience.
      </p>
      <p class="label muted soon">Site under construction</p>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    text-align: center;
    padding-block: var(--space-9);
  }
  .hero .wrap > * {
    margin-inline: auto;
  }
  .mark {
    color: var(--text);
    width: max-content;
    margin-bottom: var(--space-6);
  }
  .wordmark {
    padding-left: var(--tracking-wordmark); /* re-centre tracked capitals */
  }
  .sub {
    margin-top: var(--space-4);
  }
  .motto {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-h4);
    margin-top: var(--space-6);
  }
  hr {
    width: var(--space-7);
    margin: var(--space-6) auto;
  }
  .lede {
    max-width: 34rem;
  }
  .soon {
    margin-top: var(--space-7);
  }
</style>
