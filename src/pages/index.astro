---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Logo from '../components/Logo.astro';
import { getWebBranches } from '../data/catalog';
import { organization, website } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const branches = await getWebBranches();

/* ---- Web geometry ---------------------------------------------------------
   Everything is laid out in a 1000 x 560 box. The SVG uses it as its viewBox
   and the HTML nodes use the same numbers as percentages, so lines and nodes
   always meet, at any screen size.                                        */
const W = 1000;
const H = 560;
const C = { x: W / 2, y: H / 2 };

// Centre: the star-A wordmark (artwork viewBox 1205 x 169)
const CENTER_W = 520;
const CENTER_H = (CENTER_W * 169) / 1205;
const hw = CENTER_W / 2;
const hh = CENTER_H / 2;

const NODE_D = 96; // medallion diameter
// Where node centers sit: an oval around the wordmark, far enough out that
// each line has room to read as a line.
const ORBIT = { x: hw + 260, y: 200 };
const GAP = 12; // space between a line's end and what it touches

const nodes = branches.map((b, i) => {
  const deg = b.angle ?? (i * 360) / branches.length;
  const a = (deg * Math.PI) / 180;
  const nx = C.x + ORBIT.x * Math.cos(a);
  const ny = C.y + ORBIT.y * Math.sin(a);

  // start just outside the wordmark's box, in the node's direction
  const c = Math.cos(a);
  const sn = Math.sin(a);
  const t = Math.min(
    Math.abs(c) > 1e-6 ? hw / Math.abs(c) : Infinity,
    Math.abs(sn) > 1e-6 ? hh / Math.abs(sn) : Infinity
  );
  const sx = C.x + (t + GAP) * c;
  const sy = C.y + (t + GAP) * sn;
  // end just short of the medallion
  const dx = nx - sx;
  const dy = ny - sy;
  const len = Math.hypot(dx, dy);
  const ex = nx - (dx / len) * (NODE_D / 2 + GAP);
  const ey = ny - (dy / len) * (NODE_D / 2 + GAP);
  // a slight bow, like a line drawn by hand
  const bow = 0.1 * len;
  const qx = (sx + ex) / 2 + (dy / len) * bow;
  const qy = (sy + ey) / 2 - (dx / len) * bow;

  return {
    ...b,
    i,
    href: `${base}/${b.href}`,
    nx,
    ny,
    // labels sit under the node, or above it for branches pointing up
    labelAbove: Math.sin(a) < -0.5,
    pts: [sx, sy, qx, qy, ex, ey],
  };
});

/* Fit the box to what is actually drawn (wordmark, nodes and their labels),
   so the group is always centred and as large as the screen allows,
   however many branches there are. Labels are HTML, so their size is an
   allowance in box units: about 11rem wide and four lines tall. */
const LABEL_HALF_W = 80;
const LABEL_H = 130;
const PAD = 20;
const xs = [C.x - hw, C.x + hw];
const ys = [C.y - hh, C.y + hh];
for (const n of nodes) {
  const r = NODE_D / 2;
  xs.push(n.nx - Math.max(r, LABEL_HALF_W), n.nx + Math.max(r, LABEL_HALF_W));
  ys.push(n.ny - r, n.ny + r);
  ys.push(n.labelAbove ? n.ny - r - LABEL_H : n.ny + r + LABEL_H);
}
const minX = Math.min(...xs) - PAD;
const minY = Math.min(...ys) - PAD;
const BW = Math.max(...xs) + PAD - minX;
const BH = Math.max(...ys) + PAD - minY;
const fx = (x: number) => (x - minX).toFixed(1);
const fy = (y: number) => (y - minY).toFixed(1);

const placed = nodes.map((n) => {
  const [sx, sy, qx, qy, ex, ey] = n.pts;
  return {
    ...n,
    left: ((n.nx - minX) / BW) * 100,
    top: ((n.ny - minY) / BH) * 100,
    d: `M ${fx(sx)} ${fy(sy)} Q ${fx(qx)} ${fy(qy)} ${fx(ex)} ${fy(ey)}`,
  };
});
const center = {
  left: ((C.x - minX) / BW) * 100,
  top: ((C.y - minY) / BH) * 100,
  w: (CENTER_W / BW) * 100,
};
---

<BaseLayout
  ground="parchment"
  jsonLd={{ '@context': 'https://schema.org', '@graph': [organization, website] }}
>
  <TopBar />
  <main id="main">
    <section class="web" aria-labelledby="web-title">
      <!-- The heading comes first for screen readers; CSS places it under the web. -->
      <div class="web-intro">
        <h1 id="web-title">A workshop for designing watches</h1>
        <p class="muted">From the timeless to the futuristic.</p>
      </div>

      <!-- Wide screens: the wordmark with branches drawn out to nodes -->
      <div
        class="web-stage"
        style={`--center-w:${center.w}%; --center-x:${center.left}%; --center-y:${center.top}%; --node-d:${(NODE_D / BW) * 100}%; --ratio:${BW / BH};`}
      >
        <svg class="web-lines" viewBox={`0 0 ${BW.toFixed(1)} ${BH.toFixed(1)}`} aria-hidden="true" focusable="false">
          {placed.map((n) => (
            <g class="branch-line" data-branch={n.i} style={`--i:${n.i}`}>
              <path class="line-casing" d={n.d} />
              <path class="line-light" d={n.d} />
              <path class="line-ink" d={n.d} />
            </g>
          ))}
        </svg>

        <div class="web-center">
          <Logo variant="wordmark-star" width="100%" />
        </div>

        <ul class="web-nodes" role="list" aria-label="Branches">
          {placed.map((n) => (
            <li
              class:list={['node', { 'label-above': n.labelAbove }]}
              style={`left:${n.left}%; top:${n.top}%; --i:${n.i}`}
            >
              <a
                class="node-link"
                href={n.href}
                data-branch={n.i}
                aria-labelledby={`node-${n.i}-title`}
                aria-describedby={`node-${n.i}-blurb`}
              >
                <span class="node-disc" data-ground="plum">
                  <Logo variant={n.icon} decorative height="70%" />
                </span>
                <span class="node-label">
                  <span class="node-title" id={`node-${n.i}-title`}>{n.title}</span>
                  <span class="node-blurb" id={`node-${n.i}-blurb`}>{n.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Phones: the wordmark on top, a plain list below -->
      <div class="phone-center">
        <Logo variant="wordmark-star" width="100%" decorative />
      </div>

      <nav class="phone-nav" aria-label="Branches">
        <ul class="phone-list" role="list">
          {placed.map((n) => (
            <li>
              <a
                class="phone-item"
                href={n.href}
                aria-labelledby={`phone-${n.i}-title`}
                aria-describedby={`phone-${n.i}-blurb`}
              >
                <span class="phone-disc" data-ground="plum">
                  <Logo variant={n.icon} decorative height="64%" />
                </span>
                <span>
                  <span class="phone-title" id={`phone-${n.i}-title`}>{n.title}</span>
                  <span class="phone-blurb" id={`phone-${n.i}-blurb`}>{n.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  /* ---- Section: fills the screen under the top bar ---------------------- */
  .web {
    height: calc(100svh - var(--bar-h));
    min-height: 34rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) var(--grid-margin) var(--space-6);
  }

  .web-stage,
  .phone-center {
    order: 1;
  }
  .web-intro {
    order: 2;
    text-align: center;
  }
  .phone-nav {
    order: 3;
  }
  .web-intro h1 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-1);
  }
  .web-intro p {
    margin: 0 auto;
  }

  /* ---- Stage ---------------------------------------------------------------- */
  .web-stage {
    position: relative;
    /* as wide as fits, but never taller than the space left on screen */
    /* as wide as fits, but never taller than the screen space left over */
    width: min(100%, 72rem, calc((100svh - var(--bar-h) - 13rem) * var(--ratio)));
    aspect-ratio: var(--ratio);
    flex: none; /* never squash it: lines and nodes share one box */
  }
  .web-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .web-center {
    position: absolute;
    left: var(--center-x);
    top: var(--center-y);
    width: var(--center-w);
    translate: -50% -50%;
  }
  .web-center :global(.logo) {
    width: 100%;
  }

  /* Lines: an ink line, with a lit version (popcorn on a plum casing,
     because popcorn alone vanishes on parchment) faded in on hover. */
  .branch-line path {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .line-ink {
    stroke: var(--color-ink);
    stroke-width: 1.5;
    transition: opacity var(--dur-base) ease;
  }
  .line-casing {
    stroke: var(--color-plum);
    stroke-width: 6;
  }
  .line-light {
    stroke: var(--color-popcorn);
    stroke-width: 2.5;
  }
  .line-casing,
  .line-light {
    opacity: 0;
    transition: opacity var(--dur-base) ease;
  }
  .branch-line.is-lit .line-casing,
  .branch-line.is-lit .line-light {
    opacity: 1;
  }
  .branch-line.is-lit .line-ink {
    opacity: 0;
  }

  /* ---- Nodes ------------------------------------------------------------- */
  .web-nodes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .node {
    position: absolute;
    width: var(--node-d);
    aspect-ratio: 1;
    translate: -50% -50%;
  }
  .node-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    border-radius: 50%;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .node-disc {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .node-disc :global(.logo) {
    width: auto;
  }
  .node-label {
    position: absolute;
    left: 50%;
    top: calc(100% + var(--space-3));
    translate: -50% 0;
    width: max-content;
    max-width: 11rem;
    text-align: center;
  }
  .label-above .node-label {
    top: auto;
    bottom: calc(100% + var(--space-3));
  }
  .node-title {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    color: var(--heading);
  }
  .node-blurb {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-small);
    line-height: var(--leading-small);
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .node-link:hover {
      transform: translateY(-2px);
    }
    .node-link:hover .node-disc {
      box-shadow: 0 6px 16px -8px rgb(28 19 20 / 0.45);
    }
  }
  .node-link:focus-visible {
    outline: none;
  }
  .node-link:focus-visible .node-disc {
    outline: var(--focus-width) solid var(--color-ink);
    outline-offset: var(--focus-offset);
  }
  .node-link:active {
    transform: translateY(0) scale(0.98);
    transition-duration: var(--dur-fast);
  }

  /* ---- Entrance: once, on load ----------------------------------------------
     wordmark settles, then each line draws out, then its node arrives.          */
  @keyframes center-in {
    from { opacity: 0; scale: 0.97; }
  }
  /* --len is each line's on-screen length in px, set by the script below.
     Dashes are only used while drawing, so the finished line is always whole. */
  @keyframes draw {
    from { stroke-dasharray: var(--len) var(--len); stroke-dashoffset: var(--len); }
    to { stroke-dasharray: var(--len) var(--len); stroke-dashoffset: 0; }
  }
  @keyframes node-in {
    from { opacity: 0; transform: translateY(6px) scale(0.96); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }

  .web-center {
    animation: center-in 600ms var(--ease-out) both;
  }
  .branch-line path {
    animation: draw 900ms var(--ease-in-out) backwards;
    animation-delay: calc(350ms + var(--i) * 140ms);
  }
  .node {
    animation: node-in 420ms var(--ease-out) both;
    animation-delay: calc(1050ms + var(--i) * 140ms);
  }
  .web-intro {
    animation: fade-in 500ms ease both;
    animation-delay: 200ms;
  }

  /* Reduced motion: no drawing or moving; things just appear, gently. */
  @media (prefers-reduced-motion: reduce) {
    .web-center,
    .web-intro {
      animation: fade-in 200ms ease both;
    }
    .branch-line path {
      animation: none;
    }
    .node {
      animation: fade-in 200ms ease both;
    }
    .node-link,
    .node-link:hover,
    .node-link:active {
      transform: none;
    }
  }

  /* ---- Phones -------------------------------------------------------------- */
  .phone-center,
  .phone-nav {
    display: none;
  }

  @media (max-width: 767px) {
    .web {
      justify-content: flex-start;
      align-items: stretch;
      gap: 0;
      height: auto;
      min-height: calc(100svh - var(--bar-h));
      padding-top: var(--space-6);
    }
    .web-stage {
      display: none;
    }
    .phone-center {
      display: block;
      width: min(82vw, 21rem);
      margin: var(--space-5) auto var(--space-6);
      animation: center-in 500ms var(--ease-out) both;
    }
    .web-intro {
      margin-bottom: var(--space-6);
    }
    .phone-nav {
      display: block;
    }
    .phone-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: var(--border-width) solid color-mix(in srgb, var(--color-plum) 18%, transparent);
    }
    .phone-list li {
      border-bottom: var(--border-width) solid color-mix(in srgb, var(--color-plum) 18%, transparent);
    }
    .phone-item {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      min-height: 4.5rem;
      padding-block: var(--space-3);
      text-decoration: none;
    }
    .phone-item:active {
      background: color-mix(in srgb, var(--color-plum) 6%, transparent);
    }
    .phone-disc {
      flex: none;
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
    }
    .phone-disc :global(.logo) {
      width: auto;
    }
    .phone-title {
      display: block;
      font-family: var(--font-heading);
      font-weight: var(--weight-heading);
      font-size: var(--text-h4);
      line-height: var(--leading-h4);
      color: var(--heading);
    }
    .phone-blurb {
      display: block;
      font-size: var(--text-small);
      line-height: var(--leading-small);
      color: var(--text-muted);
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .phone-center {
      animation: fade-in 200ms ease both;
    }
  }
</style>

<script>
  // Measure each line's length on screen so the draw-in covers all of it.
  document.querySelectorAll<SVGPathElement>('.branch-line path').forEach((path) => {
    const ctm = path.getScreenCTM();
    const scale = ctm ? Math.hypot(ctm.a, ctm.b) : 1;
    path.style.setProperty('--len', `${Math.ceil(path.getTotalLength() * scale) + 2}px`);
  });

  // Light a branch's line while its node is hovered or focused.
  document.querySelectorAll<HTMLAnchorElement>('.node-link').forEach((link) => {
    const line = document.querySelector(`.branch-line[data-branch="${link.dataset.branch}"]`);
    if (!line) return;
    const on = () => line.classList.add('is-lit');
    const off = () => line.classList.remove('is-lit');
    link.addEventListener('pointerenter', on);
    link.addEventListener('pointerleave', off);
    link.addEventListener('focus', on);
    link.addEventListener('blur', off);
  });
</script>
