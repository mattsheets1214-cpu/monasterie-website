---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines (used by /styleguide). */
  noindex?: boolean;
  /** Ground for the whole page: 'plum' (default) or 'parchment'. */
  ground?: 'plum' | 'parchment';
}

const {
  title = 'Monasterie Watch Company',
  description = 'Monasterie Watch Company designs watches, from the timeless to the futuristic, in the spirit of the monks who improved the human experience.',
  noindex = false,
  ground = 'plum',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Social previews need absolute URLs
const ogImage = new URL(`${base}/og-image.png`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={ground === 'plum' ? '#3c2d2e' : '#f4efe7'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Monasterie Watch Company" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Monasterie Watch Company: bell-tower window with a star, the wordmark, and Conversatio Morum" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
  </head>
  <body data-ground={ground}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
