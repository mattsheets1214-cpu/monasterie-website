---
import '../styles/global.css';

interface Props {
  /** Shown in the browser tab, Google results and share previews (aim for 50-60 characters). */
  title?: string;
  /** Shown under the title in Google and in some share previews (aim for 120-160 characters). */
  description?: string;
  /** Share preview image, 1200 x 630: a file name in public/ (e.g. og-image.png)
      or a site path starting with / (e.g. a generated watch photo). */
  image?: string;
  imageAlt?: string;
  /** Keep the page out of search engines (style guide, 404). */
  noindex?: boolean;
  /** Ground for the whole page: 'plum' (default) or 'parchment'. */
  ground?: 'plum' | 'parchment';
  /** schema.org structured data for this page, as a plain object. */
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Monasterie Watch Company | A workshop for designing watches',
  description = 'Monasterie Watch Company designs watches, from the timeless to the futuristic, in the spirit of the monks who improved the human experience.',
  image = 'og-image.png',
  imageAlt = 'The Monasterie window and star, the wordmark, and the motto Conversatio Morum.',
  noindex = false,
  ground = 'plum',
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Share previews and canonical links need full https:// addresses
const ogImage = image.startsWith('/')
  ? new URL(image, Astro.site).href
  : new URL(`${base}/${image}`, Astro.site).href;
const ogImageType = /\.jpe?g$/i.test(ogImage.split('?')[0]) ? 'image/jpeg' : 'image/png';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={pageUrl} />}
    <meta name="theme-color" content={ground === 'plum' ? '#3c2d2e' : '#f4efe7'} />

    <!-- Share previews: iMessage, Instagram and Facebook DMs, Slack, LinkedIn, X -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Monasterie Watch Company" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-ground={ground}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
