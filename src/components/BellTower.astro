---
// Simple placeholder bell-tower mark. Swap for the final logo SVG when ready.
interface Props {
  size?: number;
}
const { size = 72 } = Astro.props;
---

<svg
  width={size}
  height={size * 1.4}
  viewBox="0 0 50 70"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linejoin="round"
  role="img"
  aria-label="Monasterie bell tower"
>
  <path d="M25 3 L36 20 H14 Z" />
  <rect x="14" y="20" width="22" height="18" />
  <path d="M20 38 V30 a5 5 0 0 1 10 0 V38" />
  <circle cx="25" cy="32.5" r="1.6" fill="currentColor" stroke="none" />
  <rect x="12" y="38" width="26" height="29" />
  <path d="M21 67 V56 a4 4 0 0 1 8 0 V67" />
  <line x1="8" y1="67" x2="42" y2="67" />
</svg>
