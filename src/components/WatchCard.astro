---
/** A watch in a category grid: first photo, name, status and price. */
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { formatPrice, statusLabel, watchHref, type Watch } from '../data/catalog';

interface Props {
  watch: Watch;
}
const { watch } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = watch.data.photos[0];
---

<a class="card" href={`${base}/${watchHref(watch)}`}>
  <span class="card-photo">
    {photo ? (
      <Image src={photo.src} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" />
    ) : (
      <span class="card-empty" data-ground="plum">
        <Logo variant="icon" height="40%" decorative />
      </span>
    )}
  </span>
  <span class="card-name">{watch.data.name}</span>
  <span class="card-meta">{statusLabel(watch.data.status)} · {formatPrice(watch.data.price)}</span>
</a>

<style>
  .card {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .card-photo {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-plum) 10%, var(--color-parchment));
    margin-bottom: var(--space-2);
  }
  .card-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--dur-base) var(--ease-out);
  }
  .card-empty {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .card-empty :global(.logo) {
    width: auto;
  }
  .card-name {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h4);
    line-height: var(--leading-h4);
    color: var(--heading);
  }
  .card-meta {
    font-size: var(--text-small);
    color: var(--text-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-2px);
    }
    .card:hover .card-photo :global(img) {
      scale: 1.03;
    }
  }
  .card:focus-visible {
    outline: none;
  }
  .card:focus-visible .card-photo {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transform: none;
    }
    .card:hover .card-photo :global(img) {
      scale: 1;
    }
  }
</style>
